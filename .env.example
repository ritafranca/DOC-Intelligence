APP_NAME=DOC Intelligence
ENVIRONMENT=development
TESTING=false
DEMO_AUTOPROCESS=false
DATABASE_URL=postgresql+asyncpg://docintelligence:docintelligence@127.0.0.1:5432/docintelligence
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
REDIS_URL=redis://:docintelligence@127.0.0.1:6379/0
QUEUE_NAME=doc-intelligence
WORKER_CONCURRENCY=8
MAX_PROCESSING_ATTEMPTS=3
S3_ENDPOINT_URL=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=doc-intelligence
S3_ACCESS_KEY_ID=docintelligence
S3_SECRET_ACCESS_KEY=docintelligence-secret
S3_SSE_ALGORITHM=AES256
S3_SSE_KMS_KEY_ID=
S3_AUTO_CREATE_BUCKET=true
AUTH_DISABLED=false
AUTH_PROVIDER=local
JWT_SECRET_KEY=dev-only-change-this-jwt-secret-now
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_MINUTES=480
JWT_ISSUER=doc-intelligence
JWT_AUDIENCE=doc-intelligence-spa
DEFAULT_ADMIN_NAME=Administrador
DEFAULT_ADMIN_EMAIL=admin@doc.local
DEFAULT_ADMIN_PASSWORD=admin
OIDC_ISSUER=http://127.0.0.1:8080/realms/doc-intelligence
OIDC_AUDIENCE=doc-intelligence-api
OIDC_CLIENT_ID=doc-intelligence-spa
OIDC_SCOPES=openid profile email roles
OIDC_ALGORITHMS=RS256
DATA_DIR=./data
MAX_UPLOAD_BYTES=20971520
MAX_PDF_PAGES=40
REVIEW_THRESHOLD=0.85
REVIEW_LEASE_SECONDS=600
RETENTION_DAYS=365
AUDIT_HMAC_KEY=dev-only-change-this-audit-key
EXTRACTOR_STRATEGY=local
LOCAL_OCR_LANG=pt
LOCAL_OCR_CPU_THREADS=4
LOCAL_OCR_EXECUTOR_WORKERS=1
LOCAL_OCR_POPPLER_PATH=
PROMPT_VERSION=local_ocr_rules_v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_TIMEOUT_SECONDS=50
OPENAI_MAX_RETRIES=2
LLM_PROVIDER_URL=
LLM_PROVIDER_API_KEY=
LLM_PROVIDER_MODEL=vision-model-v1
LLM_PROVIDER_TIMEOUT_SECONDS=50
